APP_NAME="MINI-RAG"
APP_VERSION="0.1"
OPEN_AI_API_KEY=""

File_ALLOWED_TYPES=["text/plain", "application/pdf"]
FILE_MAX_SIZE=10  # 10 MB
FILE_DEFAULT_CHUNK_SIZE=512000  # 512 KB
MONGO_URI="mongodb://admin:admin@localhost:27007"
MONGO_DB_NAME="mini_rag"
# ==================== LLM Factory Configurations ===========================================
GENARTION_BACKEND="OPENAI"
EMBEDDING_BACKEND="COHERE"

OPENAI_API_KEY=""
OPENAI_API_URL=""  
COHERE_API_KEY=""
GENERATION_MODEL_ID="command-r7b-12-2024"
EMBEDDING_MODEL_ID="embed-multilingual-light-v3.0"
EMBDDING_MODEL_SIZE=384
INPUT_DEFAULT_MAX_CHARCTERS=1024
GENERATION_DEFAULT_MAX_CHARCTERS=200
GENERATION_DEFAULT_TEMPERATURE=0.1

# ================================= Vector DB Config ============================================

VECTORDB_BACKEND="QDRANT"
VECTOR_DB_PATH="qdrant_db"
VECTOR_DB_METHOD="cosine"